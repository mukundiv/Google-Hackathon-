# ---------------------------------------------------------------------------
# Creator Opportunity Engine — configuration
#
# Every value here is OPTIONAL. With none of them set, the whole console runs
# on seeded data. Turn sources live one at a time; see SETUP.md for how to get
# each credential and docs/API_INTEGRATION_TIMELINE.md for what each unlocks.
# ---------------------------------------------------------------------------

# --- provider modes --------------------------------------------------------
# gemini:    mock | live
# youtube:   mock | live
# trends:    mock | bigquery
# analytics: mock | oauth
#
# A mode set to live without its credential falls back to mock and says so on
# /api/health, so a missing key degrades the demo instead of breaking it.
GEMINI_MODE=mock
YOUTUBE_MODE=mock
TRENDS_MODE=mock
ANALYTICS_MODE=mock

# --- credentials -----------------------------------------------------------
# Phase 1 — Google AI Studio: https://aistudio.google.com/apikey
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
GEMINI_GROUNDED_MODEL=gemini-2.5-flash
GEMINI_EMBEDDING_MODEL=gemini-embedding-001

# Phase 2 — Google Cloud Console, YouTube Data API v3 enabled
YOUTUBE_API_KEY=

# Phase 3 — a GCP project with billing on, for the BigQuery public dataset
GCP_PROJECT_ID=

# Phase 4 — OAuth client JSON, for verified analytics on connected channels
GOOGLE_OAUTH_CLIENT_SECRETS=

# --- behaviour -------------------------------------------------------------
CACHE_TTL_SECONDS=21600
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
